<package format="3">
  <name>ibow-lcd</name>
  <version>0.1.0</version>
  <description>Appearance-based Loop Closure Detection using Incremental Bags of Binary Words.</description>

  <maintainer email="emilio.garcia@uib.es">Emilio Garcia-Fidalgo</maintainer>
  <author email="emilio.garcia@uib.es">Emilio Garcia-Fidalgo</author>

  <license>GPL</license>
  <url type="website">http://wiki.ros.org/ibow-lcd</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>obindex2</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <cpp lflags="-L${prefix}/lib -Wl,-rpath,${prefix}/lib -llcdetector"
      cflags="-I${prefix}/include/" />
  </export>
</package>